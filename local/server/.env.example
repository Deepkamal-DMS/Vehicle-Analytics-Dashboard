# Copy this to .env (gitignored - never commit the real file) and fill
# in real values. See server.js's own header for what each one does.

PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vahan

# Only used once, the very first time server.js runs against an empty
# accounts table (see ensureSeedAccounts()). Usernames may be left as
# defaults if unset; if a *_PASSWORD is left unset, a random one is
# generated and printed to the console on that first run instead -
# write it down, it is shown only once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ANUJ_USERNAME=Anuj
SEED_ANUJ_PASSWORD=
